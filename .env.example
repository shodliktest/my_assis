# Vercel → Project → Settings → Environment Variables (Production + Preview)
# Server-only. Do NOT prefix these with VITE_ (that would leak keys to the browser).

# Primary AI provider (Groq). Required for arbitrary questions.
GROQ_API_KEY=

# Optional extra Groq keys. Requests start on a different key each time; a key that hits 429 is
# parked for its retry-after, 401/403 drops it for 10 minutes. Groq limits are per ORGANIZATION:
# keys from one account share one budget, keys from different accounts add up.
# GROQ_API_KEY1=
# GROQ_API_KEY2=

# Optional: per-request token limit of your Groq plan (free plan: 8000). Output length is fitted to it.
# Without it the app adapts by itself after the first 413. On a paid plan set a big value (e.g. 250000)
# so full lessons can be longer.
# GROQ_TPM_LIMIT=8000

# Optional: comma-separated Groq model list, best first (every key is tried on a model before the next model) (default: openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b).
# GROQ_MODELS=

# Optional xAI fallback (used only if every Groq key/model fails).
# XAI_API_KEY=
# XAI_MODEL=grok-4.5

# Optional public origin for og:image / og:url. On Vercel it is filled in
# automatically from the production domain; set it only for a custom domain
# that Vercel does not report, e.g. https://daftar.example.uz
# VITE_SITE_URL=

# Not used by Daftar (no database). Leave unset.
# DATABASE_URL=
